{
  "name": "pequenosfrutos/hostinger",
  "description": "Loja PequenosFrutos PHP/MySQL para Hostinger",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "phpmailer/phpmailer": "^6.9"
  },
  "config": {
    "vendor-dir": "public_html/vendor",
    "sort-packages": true,
    "allow-plugins": false
  }
}
